{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.test)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo rename*)",
      "Bash(npm run db:push*)",
      "Bash(npx drizzle-kit push*)",
      "Bash(git commit --no-verify*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npm run db:migrate*)",
      "Bash(npx drizzle-kit migrate*)"
    ],
    "allow": [
      "Bash(npm run verify*)",
      "Bash(npm test*)",
      "Bash(npm run test:agents*)",
      "Bash(npm run lint*)",
      "Bash(npm run guard*)",
      "Bash(npm run agents:sync*)",
      "Bash(npm run agents:check*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(gh pr view*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr list*)"
    ]
  },
  "enabledMcpjsonServers": [
    "playwright",
    "tracker"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/agent-guards/hook.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
