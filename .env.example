# Copy to .env.local and fill in. Never commit real values.
# Every variable is required unless marked optional.

# --- Database (Neon Postgres connection string) ---
DATABASE_URL=

# --- Auth.js ---
# Generate with: npx auth secret
# Also signs quote tokens and guest verification cookies.
AUTH_SECRET=
# Optional: public base URL of the app (defaults to the request host)
AUTH_URL=

# Optional sign-in providers. Each one is enabled only when its variables are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
RESEND_API_KEY=
# Optional: sender for magic links and confirmation emails
AUTH_EMAIL_FROM=

# --- LiteAPI (use a sandbox key, which starts with sand_) ---
LITEAPI_KEY=
# Optional: defaults to https://api.liteapi.travel/v3.0
LITEAPI_BASE_URL=
# Shared secret LiteAPI sends in the authorization header of webhooks
LITEAPI_WEBHOOK_SECRET=

# --- Anthropic (natural-language search) ---
ANTHROPIC_API_KEY=

# --- Operations ---
# Bearer token required by /api/cron/* routes
CRON_SECRET=
# Optional: base URL used in email links
APP_URL=
