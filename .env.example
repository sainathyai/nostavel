# Copy to .env.local and fill in. Never commit real values.
# Every variable is required unless marked optional.

# --- Database (Neon Postgres connection string) ---
DATABASE_URL=

# --- Auth.js ---
# Generate with: npx auth secret
# Also signs quote tokens and guest verification cookies.
AUTH_SECRET=
# Optional: public base URL of the app (defaults to the request host)
AUTH_URL=

# Optional sign-in providers. Each one is enabled only when its variables are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
RESEND_API_KEY=
# Optional: sender for magic links and confirmation emails
AUTH_EMAIL_FROM=

# --- LiteAPI (use a sandbox key, which starts with sand_) ---
LITEAPI_KEY=
# Optional: defaults to https://api.liteapi.travel/v3.0
LITEAPI_BASE_URL=
# Shared secret LiteAPI sends in the authorization header of webhooks
LITEAPI_WEBHOOK_SECRET=

# --- Anthropic (natural-language search) ---
ANTHROPIC_API_KEY=

# --- Operations ---
# Bearer token required by /api/cron/* routes, and by /api/health?deep=1
CRON_SECRET=
# Base URL used in email links. Optional on a laptop (defaults to
# http://localhost:3000); REQUIRED in a deployed environment, where that default
# would send every guest a dead link.
APP_URL=

# --- Deployed environments only (leave all three unset on a laptop) ---
# Which environment this process is. Unset or "local" means a developer's own
# machine: no password gate, and no refusal to start over a missing variable.
# Anything else ("uat") means a copy other people can reach, and every check in
# src/lib/deploy-config.ts applies.
APP_ENV=
# Password for the HTTP Basic gate in front of a shared environment. Any
# username is accepted. At least 16 characters, generated not memorable. A
# shared environment refuses to serve without it.
ACCESS_PASSWORD=
# The commit the image was built from, reported by /api/health. Set by the
# delivery pipeline as a build argument; never set this by hand.
APP_SHA=

# Ticket tracker, used by the agent layer's tracker tool server
# (tools/tracker-mcp). Read by that server only; never passed to an agent's
# environment. Token: id.atlassian.com > Security > Create API token with
# scopes (Jira: read:jira-work, write:jira-work, read:jira-user).
JIRA_SITE=
JIRA_EMAIL=
JIRA_API_TOKEN=
