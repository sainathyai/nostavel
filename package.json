{
  "name": "lantern",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "node scripts/test-int.mjs",
    "prepare": "node scripts/git-guard.mjs --install",
    "guard": "node scripts/git-guard.mjs --all",
    "test:agents": "node --test \"scripts/**/*.test.mjs\"",
    "agents:sync": "node scripts/agents-sync.mjs",
    "agents:check": "node scripts/agents-sync.mjs --check",
    "tracker:check": "node tools/tracker-mcp/check.ts",
    "vendored:check": "node scripts/check-vendored.mjs",
    "vendored:fix": "node scripts/check-vendored.mjs --fix",
    "verify": "npm run guard && npm run test:agents && npm run agents:check && npm run vendored:check && npm run lint && tsc --noEmit && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@auth/drizzle-adapter": "^1.11.3",
    "@neondatabase/serverless": "^1.1.0",
    "@protomaps/basemaps": "^5.7.2",
    "drizzle-orm": "^0.45.2",
    "maplibre-gl": "^6.4.1",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "pmtiles": "^4.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tz-lookup": "^6.1.25",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
